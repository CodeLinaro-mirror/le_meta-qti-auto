From: GANGA BHAVANI YENUGULA <quic_gyenugul@quicinc.com>
Date: Tue, 6 Jun 2023 17:39:17 +0530
Subject: [PATCH 1/3] minadbd : Added cflags to support strlcpy function

Change-Id: I94139da7d7000530ac3ff265fce90db68d473326
---
 minadbd/Makefile.am | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/minadbd/Makefile.am b/minadbd/Makefile.am
index aaf525b..eb4b953 100644
--- a/minadbd/Makefile.am
+++ b/minadbd/Makefile.am
@@ -32,7 +32,7 @@ requiredlibs := -ladbd -lbase
 
 if USE_GLIB
 libminadbd_la_CFLAGS := $(AM_CFLAGS) -DUSE_GLIB @GLIB_CFLAGS@
-libminadbd_la_CPPFLAGS := $(AM_CPPFLAGS) -DUSE_GLIB @GLIB_CFLAGS@
+libminadbd_la_CPPFLAGS := $(AM_CPPFLAGS) -DUSE_GLIB -include glib.h -Dstrlcat=g_strlcat -Dstrlcpy=g_strlcpy @GLIB_CFLAGS@
 libminadbd_la_LIBADD := $(requiredlibs) -lm -lpthread @GLIB_LIBS@
 #libminadbd_la_LDFLAGS := -all-static
 else
