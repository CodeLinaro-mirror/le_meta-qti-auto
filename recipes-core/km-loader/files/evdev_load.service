[Unit]
Description=Load evdev kernel module
After=init_sys_mss.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'modprobe evdev'
ExecStop=/bin/sh -c 'rmmod evdev'
Nice=-5
RemainAfterExit=yes

[Install]
WantedBy=sockets.target
