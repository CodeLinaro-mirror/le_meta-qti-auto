[Unit]
After=telaf.mount.service
ConditionPathExists=!/mnt/legato/systems/current/read-only
DefaultDependencies=no

[Mount]
Type=ubifs
What=ubi0:telaf_app
Where=/cv2x_extra
Options=bulk_read,rw,exec,nodev,nosuid
