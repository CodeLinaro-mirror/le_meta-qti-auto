[Unit]
Description=Mount vm-bootsys partition to /vm-bootsys mount point
ConditionDirectoryNotEmpty=!/vm-bootsys
SourcePath=/etc/initscripts/vm-bootsys-ext4-mount.sh
Before=local-fs.target
DefaultDependencies=no

IgnoreOnIsolate=true

[Service]
Type=oneshot
RemainAfterExit=yes
PassEnvironment="SLOT_SUFFIX"
ExecStart=/etc/initscripts/vm-bootsys-ext4-mount.sh

[Install]
WantedBy=local-fs.target
