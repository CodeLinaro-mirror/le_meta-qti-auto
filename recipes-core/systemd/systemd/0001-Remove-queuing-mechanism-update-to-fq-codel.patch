From b83f054697aedcf2bc9023023020a2cfb0a9215a Mon Sep 17 00:00:00 2001
From: Raghava Chowdam <rchowdam@codeaurora.org>
Date: Tue, 17 Sep 2019 09:39:52 +0530
Subject: [PATCH] meta-qti-auto: Remove queuing mechanism update to fq_codel

Fair Queue CoDel packet scheduler is not being used as queuing
mechanism for Linux networking. This patch removes queing mechanism
update to fq_codel.

Change-Id: I24d771e91d8fe523414687f3828afe20a80d53d1
---
diff --git a/sysctl.d/50-default.conf b/sysctl.d/50-default.conf
index e263cf0..96390ac 100644
--- a/sysctl.d/50-default.conf
+++ b/sysctl.d/50-default.conf
@@ -30,9 +30,6 @@ net.ipv4.conf.all.accept_source_route = 0
 # Promote secondary addresses when the primary address is removed
 net.ipv4.conf.all.promote_secondaries = 1

-# Fair Queue CoDel packet scheduler to fight bufferbloat
-net.core.default_qdisc = fq_codel
-
 # Enable hard and soft link protection
 fs.protected_hardlinks = 1
 fs.protected_symlinks = 1
--
2.7.4
