From c010c79bf2968fa41f0c721a9c3c987d261a0cd2 Mon Sep 17 00:00:00 2001
From: Deepak Dimri <quic_ddimri@quicinc.com>
Date: Wed, 19 Jan 2022 20:03:00 +0530
Subject: [PATCH] Allow system user to use dbus for communication

Signed-off-by: Deepak Dimri <quic_ddimri@quicinc.com>
---
 src/libsystemd/sd-bus/bus-convenience.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/libsystemd/sd-bus/bus-convenience.c b/src/libsystemd/sd-bus/bus-convenience.c
index 70ab170c9c..7a4d4ef81d 100644
--- a/src/libsystemd/sd-bus/bus-convenience.c
+++ b/src/libsystemd/sd-bus/bus-convenience.c
@@ -603,6 +603,10 @@ _public_ int sd_bus_query_sender_privilege(sd_bus_message *call, int capability)
                         /* Other specific users also allowed access (powermgr) */
                         if (sender_uid == 3014)
                                 return 1;
+
+                        /* Other specific users also allowed access (system) */
+                        if (sender_uid == 1000)
+                                return 1;
                 }
         }
 
