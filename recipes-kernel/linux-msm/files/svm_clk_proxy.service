[Unit]
Description=Proxy clk service for SVM
After=vm-bootsys-mount.service
Before=qvirtmgr.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo 1 >/sys/kernel/debug/clk/gcc_qupv3_wrap0_s6_clk/clk_prepare_enable'
ExecStop=/bin/sh -c 'echo 0 >/sys/kernel/debug/clk/gcc_qupv3_wrap0_s6_clk/clk_prepare_enable'

[Install]
WantedBy=multi-user.target
