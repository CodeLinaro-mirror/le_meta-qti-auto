From 0ac56d758e4a3beb6273d5c4a5657e889eedef04 Mon Sep 17 00:00:00 2001
From: Rishi Gupta <rishgupt@codeaurora.org>
Date: Mon, 9 Nov 2020 21:20:56 +0530
Subject: [PATCH] keys: bypass selinux key permissions checking

By pass selinux key permissions checking.

Change-Id: Ia21a7f1490815998c2b4b203d414491c1d737a56
Signed-off-by: Rishi Gupta <rishgupt@codeaurora.org>
---
 security/keys/permission.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/security/keys/permission.c b/security/keys/permission.c
index a72b4dd..97d1653 100644
--- a/security/keys/permission.c
+++ b/security/keys/permission.c
@@ -74,6 +74,7 @@ int key_task_permission(const key_ref_t key_ref, const struct cred *cred,
 		return -EACCES;
 
 	/* let LSM be the final arbiter */
+	return 0;
 	return security_key_permission(key_ref, cred, perm);
 }
 EXPORT_SYMBOL(key_task_permission);
-- 
2.7.4

