From b4ee0d76775b79d054a03436c04f444e740e258d Mon Sep 17 00:00:00 2001
From: Akshaya Bhat <quic_akshayab@quicinc.com>
Date: Mon, 21 Oct 2024 23:13:07 -0700
Subject: [PATCH] ADB: Add leprop as the supplementary group

Change-Id: I1ca692fb5f6fe4c5ada63458a12241149e313c70
Signed-off-by: Akshaya Bhat <quic_akshayab@quicinc.com>
---
 daemon/main.cpp                         | 2 +-
 1 files changed, 1 insertions(+), 1 deletion(-)

diff --git a/daemon/main.cpp b/daemon/main.cpp
index f275c688..94c87f65 100644
--- a/daemon/main.cpp
+++ b/daemon/main.cpp
@@ -139,7 +139,7 @@ int adbd_main(int server_port) {
     // AID_NET_BW_STATS to read out qtaguid statistics
     gid_t groups[] = {AID_ADB,      AID_LOG,       AID_INPUT,
                       AID_INET,     AID_NET_BT,    AID_NET_BT_ADMIN,
-                      AID_SDCARD_R, AID_SDCARD_RW, AID_NET_BW_STATS};
+                      AID_SDCARD_R, AID_SDCARD_RW, AID_NET_BW_STATS, AID_LEPROP};
     if (setgroups(sizeof(groups) / sizeof(groups[0]), groups) != 0) {
         PLOG(FATAL) << "Could not set supplemental groups";
     }
2.17.1

