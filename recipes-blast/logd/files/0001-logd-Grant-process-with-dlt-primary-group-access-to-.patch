From 88042ff53854e1d3749744a90bb857a79879f73d Mon Sep 17 00:00:00 2001
From: Zhihang YAN <quic_zhihyan@quicinc.com>
Date: Thu, 16 Jan 2025 15:01:21 +0800
Subject: [PATCH] logd: Grant process with dlt primary group access to logd
 logging

Change-Id: I88f96e9f2a0c573b87e458749bbd4a295a922a65
---
 logd/LogCommand.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/LogCommand.cpp b/LogCommand.cpp
index 06d865cd..0fc36229 100644
--- a/LogCommand.cpp
+++ b/LogCommand.cpp
@@ -1,3 +1,4 @@
+
 /*
  * Copyright (C) 2012-2014 The Android Open Source Project
  *
@@ -14,6 +15,12 @@
  * limitations under the License.
  */
 
+/* Changes from Qualcomm Innovation Center, Inc. are provided under the following license:
+ *
+ * Copyright (c) 2025 Qualcomm Innovation Center, Inc. All rights reserved.
+ * SPDX-License-Identifier: BSD-3-Clause-Clear
+ */
+
 #include <errno.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -62,9 +69,9 @@ bool clientHasLogCredentials(SocketClient * cli) {
     if (uid == AID_ROOT) {
         return true;
     }
-
+#define AID_DLT 3022
     gid_t gid = cli->getGid();
-    if ((gid == AID_ROOT) || (gid == AID_SYSTEM) || (gid == AID_LOG)) {
+    if ((gid == AID_ROOT) || (gid == AID_SYSTEM) || (gid == AID_LOG) || (gid == AID_DLT)) {
         return true;
     }
 
