From b1afec806e2c94bdd125e33798f5f45a49203a3d Mon Sep 17 00:00:00 2001
From: Xubao Jiang <xubaoj@codeaurora.org>
Date: Thu, 15 Nov 2018 17:28:09 +0800
Subject: [PATCH] libcutils: Add autotools support

Change-Id: I89079fb10cb8a5070909629947953314c81a1968
Signed-off-by: Xubao Jiang <xubaoj@codeaurora.org>
---
 include/cutils/ashmem.h | 26 ++++++++++++++++++++++++++
 libcutils/ashmem-dev.c  |  4 ++--
 2 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/include/cutils/ashmem.h b/include/cutils/ashmem.h
index 25bd2f8..e9b700a 100644
--- a/include/cutils/ashmem.h
+++ b/include/cutils/ashmem.h
@@ -41,6 +41,32 @@ int ashmem_get_size_region(int fd);
 #define ASHMEM_IS_UNPINNED	0
 #define ASHMEM_IS_PINNED	1
 
+#if LINUX_ENABLED
+
+#include <linux/limits.h>
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+struct ashmem_pin {
+    __u32 offset;
+    __u32 len;
+};
+
+#define __ASHMEMIOC 0x77
+
+#define ASHMEM_SET_NAME _IOW(__ASHMEMIOC, 1, char[ASHMEM_NAME_LEN])
+#define ASHMEM_GET_NAME _IOR(__ASHMEMIOC, 2, char[ASHMEM_NAME_LEN])
+#define ASHMEM_SET_SIZE _IOW(__ASHMEMIOC, 3, size_t)
+#define ASHMEM_GET_SIZE _IO(__ASHMEMIOC, 4)
+#define ASHMEM_SET_PROT_MASK _IOW(__ASHMEMIOC, 5, unsigned long)
+#define ASHMEM_GET_PROT_MASK _IO(__ASHMEMIOC, 6)
+#define ASHMEM_PIN _IOW(__ASHMEMIOC, 7, struct ashmem_pin)
+#define ASHMEM_UNPIN _IOW(__ASHMEMIOC, 8, struct ashmem_pin)
+#define ASHMEM_GET_PIN_STATUS _IO(__ASHMEMIOC, 9)
+#define ASHMEM_PURGE_ALL_CACHES _IO(__ASHMEMIOC, 10)
+
+#endif	/* LINUX_ENABLED */
+
 #endif	/* ! __ASHMEMIOC */
 
 #endif	/* _CUTILS_ASHMEM_H */
diff --git a/libcutils/ashmem-dev.c b/libcutils/ashmem-dev.c
index 09fa09a..526d148 100644
--- a/libcutils/ashmem-dev.c
+++ b/libcutils/ashmem-dev.c
@@ -29,9 +29,9 @@
 #include <sys/stat.h>
 #include <sys/types.h>
 #include <unistd.h>
-
+#if !LINUX_ENABLED
 #include <linux/ashmem.h>
-
+#endif
 #include <cutils/ashmem.h>
 #include <log/log.h>
 
-- 
1.9.1

