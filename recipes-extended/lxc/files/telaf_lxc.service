[Unit]
Description=Service used for TelAF LXC container start/stop
SourcePath=/etc/initscripts/container_launch.sh
After=lxcrootfs-mount.service systemd-udevd.service
ConditionDirectoryNotEmpty=/lxcrootfs
ConditionPathExists=/dev/tty_lxc

[Service]
Type=simple
PIDFile=/var/run/lxc_start_telaflxc.pid
ExecStartPre=/etc/initscripts/lxc_bridge_setup.sh
ExecStart=/etc/initscripts/container_launch.sh "start" "/etc/lxc/lxc_telaf.conf" "192.168.200.200" "telaflxc"
ExecStop=/etc/initscripts/container_launch.sh "stop" "/etc/lxc/lxc_telaf.conf" "192.168.200.200" "telaflxc"
RemainAfterExit=true
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
