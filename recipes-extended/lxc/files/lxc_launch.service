[Unit]
Description=Service used for lxc container start/stop
SourcePath=/etc/initscripts/lxc_launch.sh
After=overlay-workdir.service

[Service]
RemainAfterExit=yes
Type=simple
ExecStart=/etc/initscripts/lxc_launch.sh start
ExecStop=/etc/initscripts/lxc_launch.sh stop

[Install]
WantedBy=local-fs.target

