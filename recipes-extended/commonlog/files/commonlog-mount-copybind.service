[Unit]
Description=Common logging Service
DefaultDependencies=no
Before=local-fs.target

[Service]
Type=oneshot
Nice=-20
ExecStart=/sbin/mount-copybind /systemrw/commonlog.conf /etc/commonlog.conf
ExecStart=/sbin/mount-copybind /systemrw/commonlog-sink-config.conf /etc/commonlog-sink-config.conf

[Install]
WantedBy=local-fs.target
