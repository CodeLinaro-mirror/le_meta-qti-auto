[Unit]
Description=stream update Service
SourcePath=/usr/bin/update_engine_sideload
After=multi-user.target init_post_boot.service telaf.service mrc-daemon.service
ConditionKernelCommandLine=systemd.setenv
ConditionFileNotEmpty=/data/stream_update/properties.txt

[Service]
User=system
Group=system
SupplementaryGroups=ubi disk
CapabilityBoundingSet=CAP_SYS_RESOURCE
AmbientCapabilities=CAP_SYS_RESOURCE
Restart=on-failure
ExecStart=/usr/bin/update_engine_sideload

[Install]
WantedBy=multi-user.target

