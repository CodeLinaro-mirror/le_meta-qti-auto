From: Yan Kong <xiankong@qti.qualcomm.com>
Date: Wed, 4 Jun 2026 00:00:00 +0800
Subject: [PATCH] dlt_user: cooperative shutdown of dlt_segmented thread

Replace pthread_cancel() with cooperative shutdown to fix SIGABRT in
dlt_segmented (TELAF-4993). Set an exit flag, signal the condition
variable, and send a NULL poison pill via mq_send() so the worker exits
from both pthread_cond_wait() and mq_receive() without double-unlocking
mq_mutex. dlt_stop_threads() then joins the worker cleanly.

Upstream-Status: Pending

Signed-off-by: Yan Kong <xiankong@qti.qualcomm.com>
---
diff --git a/src/lib/dlt_user.c b/src/lib/dlt_user.c
index ec4555f5..0d81271b 100644
--- a/src/lib/dlt_user.c
+++ b/src/lib/dlt_user.c
@@ -154,6 +154,9 @@ typedef struct VarInfo
 /* Mutex to wait on while message queue is not initialized */
 pthread_mutex_t mq_mutex = PTHREAD_MUTEX_INITIALIZER;
 pthread_cond_t mq_init_condition;
+/* Cooperative shutdown flag for the segmented network-trace thread */
+static volatile sig_atomic_t dlt_segmented_thread_exit = 0;
+
 #endif /* DLT_NETWORK_TRACE_ENABLE */
 
 /* use these variables from common.c*/
@@ -3179,11 +3182,19 @@ void dlt_user_trace_network_segmented_thread(void *unused)
         /* Wait until message queue is initialized */
         dlt_lock_mutex(&mq_mutex);
 
-        while (dlt_user.dlt_segmented_queue_read_handle < 0)
+        while ((dlt_user.dlt_segmented_queue_read_handle < 0) &&
+               (dlt_segmented_thread_exit == 0))
         {
             pthread_cond_wait(&mq_init_condition, &mq_mutex);
         }
 
+        /* Cooperative shutdown requested: leave the loop normally so that we
+         * are not cancelled while holding/re-acquiring mq_mutex. */
+        if (dlt_segmented_thread_exit != 0) {
+            dlt_unlock_mutex(&mq_mutex);
+            break;
+        }
+
         dlt_unlock_mutex(&mq_mutex);
 
         ssize_t read = mq_receive(dlt_user.dlt_segmented_queue_read_handle, (char *)&data,
@@ -3202,6 +3213,15 @@ void dlt_user_trace_network_segmented_thread(void *unused)
             continue;
         }
 
+        /* Cooperative shutdown: a NULL "poison pill" is enqueued by
+         * dlt_stop_threads() to wake this thread when it is blocked in
+         * mq_receive() (pthread_cond_signal alone cannot reach it here).
+         * Check the exit flag / NULL BEFORE dereferencing data, so the
+         * poison pill never reaches the segmenter. */
+        if ((dlt_segmented_thread_exit != 0) || (data == NULL)) {
+            break;
+        }
+
         if (read != sizeof(s_segmented_data *)) {
             /* This case will not happen. */
             /* When this thread is interrupted by signal, mq_receive() will not return */
@@ -5117,16 +5137,30 @@ void dlt_stop_threads()
     int dlt_segmented_nwt_result = 0;
 
     if (dlt_user.dlt_segmented_nwt_handle) {
+        /* Cooperative shutdown: do NOT pthread_cancel() a thread that may be
+         * blocked in pthread_cond_wait() or mq_receive(). Set the exit flag and
+         * wake the worker on BOTH possible blocking points:
+         *   1) pthread_cond_signal() releases it if it waits on mq_init_condition;
+         *   2) a NULL "poison pill" enqueued below releases it if it is blocked
+         *      in mq_receive(). cond_signal alone cannot reach the mq_receive
+         *      case, which otherwise leaves pthread_join() hung (deadlock).
+         * The worker then returns on its own and is joined below. This avoids
+         * the glibc __pthread_mutex_cond_lock assertion seen with pthread_cancel. */
         dlt_lock_mutex(&mq_mutex);
+        dlt_segmented_thread_exit = 1;
         pthread_cond_signal(&mq_init_condition);
         dlt_unlock_mutex(&mq_mutex);
 
-        dlt_segmented_nwt_result = pthread_cancel(dlt_user.dlt_segmented_nwt_handle);
-
-        if (dlt_segmented_nwt_result != 0)
-            dlt_vlog(LOG_ERR,
-                     "ERROR pthread_cancel(dlt_user.dlt_segmented_nwt_handle): %s\n",
-                     strerror(dlt_segmented_nwt_result));
+        /* Poison pill: wake a worker blocked in mq_receive(). The worker checks
+         * the exit flag / NULL before dereferencing, so this never segfaults. */
+        if (dlt_user.dlt_segmented_queue_write_handle >= 0) {
+            s_segmented_data *poison = NULL;
+            if (mq_send(dlt_user.dlt_segmented_queue_write_handle,
+                        (char *)&poison, sizeof(s_segmented_data *), 1) < 0)
+                dlt_vlog(LOG_WARNING,
+                         "NWTSegmented: failed to send shutdown signal to queue: %s\n",
+                         strerror(errno));
+        }
     }
 #endif /* DLT_NETWORK_TRACE_ENABLE */
     /* make sure that the threads really finished working */
