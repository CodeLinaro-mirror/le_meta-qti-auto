[Unit]
Description=gptp daemon Service
SourcePath=/usr/bin/daemon_cl

[Service]
User=vnw
Group=vnw
Restart=on-failure
ExecStartPre=+/bin/chmod 0660 /dev/ptp0
ExecStartPre=+/bin/chown vnw:vnw /dev/ptp0
ExecStart=/usr/bin/daemon_cl eth0
SupplementaryGroups=net_admin net_raw
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target

